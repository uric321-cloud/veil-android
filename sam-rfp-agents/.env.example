# ---- SAM.gov ---------------------------------------------------------------
# Personal "Public API Key" from https://sam.gov -> sign in -> Account Details.
# Never share your SAM.gov login password with anyone; the key is all this needs.
SAM_API_KEY=

# ---- Claude (analyst agent) -------------------------------------------------
ANTHROPIC_API_KEY=

# ---- Email delivery ---------------------------------------------------------
# provider "smtp" (Gmail: smtp.gmail.com:587 with an App Password) or "resend"
EMAIL_PROVIDER=smtp
EMAIL_FROM=rfp-radar@example.com
EMAIL_TO=you@example.com,partner@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# ---- Storage ----------------------------------------------------------------
DATABASE_PATH=data/opportunities.sqlite
CONFIG_PATH=config.yaml
